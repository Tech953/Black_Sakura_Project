{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./seed": "./src/seed/index.ts",
    "./seed/engram-data": "./src/seed/engram-data.ts",
    "./seed/rebecca-adaptive-data": "./src/seed/rebecca-adaptive-data.ts",
    "./seed/full-rezz-data": "./src/seed/full-rezz-data.ts"

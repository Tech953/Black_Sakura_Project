{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "vitest run && node --test ./scripts/openapi-drift-utils.test.mjs",
    "test:hub-concurrency-pg": "node -e \"if (!process.env.DATABASE_URL) { console.error('DATABASE_URL is required for real Hub concurrency checks.'); process.exit(1); }\" && vitest run src/lib/hub-store.concurrency.pg.test.ts",
    "test:messages-pagination-pg": "node -e \"if (!process.env.ENGRAM_TEST_DATABASE_URL) { console.error('ENGRAM_TEST_DATABASE_URL is required for real message pagination checks.'); process.exit(1); }\" && ENGRAM_REQUIRE_MESSAGES_PAGINATION_PG=1 vitest run src/routes/messages.pagination.pg.test.ts",
    "check:openapi": "node ./scripts/check-openapi-generated.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "upload:desktop-storage": "node ./scripts/upload-desktop-storage.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.66",
    "@clerk/shared": "^4.31.0",
    "@electric-sql/pglite": "^0.5.3",
    "@google-cloud/storage": "^8.0.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/engram-core": "workspace:*",
    "@workspace/i18n": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "http-proxy-middleware": "^4.2.0",
    "multer": "^2.2.0",
    "openai": "^6.45.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.9"
  }
}

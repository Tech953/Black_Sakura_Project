{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voice Profile Studio Portable Reference Pack",
  "type": "object",
  "required": [
    "schema_version",
    "producer",
    "producer_version",
    "created_at",
    "pack_id",
    "profiles",
    "recordings",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "producer": {
      "type": "string"
    },
    "producer_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "pack_id": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "references",
          "reference_count",
          "reference_seconds",
          "character",
          "sources",
          "character_context",
          "expression",
          "transcription"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^voice_[a-f0-9]{16}$"
          },
          "name": {
            "type": "string"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "path",
                "recording_id",
                "segment_id",
                "source_start_seconds",
                "source_end_seconds",
                "channel",
                "duration_seconds",
                "sample_rate_hz",
                "encoding",
                "style",
                "review_status",
                "measurements"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^ref_[a-f0-9]{16}$"
                },
                "path": {
                  "type": "string"
                },
                "recording_id": {
                  "type": "string"
                },
                "segment_id": {
                  "type": "string"
                },
                "source_start_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "source_end_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "channel": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "duration_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "sample_rate_hz": {
                  "type": "integer",
                  "minimum": 1000
                },
                "encoding": {
                  "enum": [
                    "FLOAT_32",
                    "PCM_24",
                    "PCM_16"
                  ]
                },
                "style": {
                  "type": "string"
                },
                "review_status": {
                  "enum": [
                    "user_declared_single_voice",
                    "reviewed_single_voice",
                    "model_nonoverlap"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "measurements": {
                  "type": "object",
                  "required": [
                    "pitch_hz",
                    "rms_dbfs",
                    "clipping_fraction",
                    "spectral_centroid_hz",
                    "method",
                    "limitations"
                  ]
                },
                "quality": {
                  "type": "object"
                },
                "processing": {
                  "type": "object"
                }
              },
              "additionalProperties": true
            }
          },
          "reference_count": {
            "type": "integer",
            "minimum": 0
          },
          "reference_seconds": {
            "type": "number",
            "minimum": 0
          },
          "character": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Voice Profile Studio Character Context",
            "type": "object",
            "required": [
              "kind",
              "biography",
              "demographics",
              "statistics",
              "persona",
              "prompts",
              "field_sources"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "fictional",
                  "original",
                  "real_person",
                  "unspecified"
                ]
              },
              "incarnation": {
                "type": "string"
              },
              "biography": {
                "type": "string"
              },
              "demographics": {
                "type": "object",
                "description": "Sourced/authored fields; no acoustic inference"
              },
              "statistics": {
                "type": "object",
                "description": "Preserve value, units, system, edition, and source context"
              },
              "persona": {
                "type": "object",
                "properties": {
                  "traits": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "motivations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "goals": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "speech_style": {
                    "type": "string"
                  },
                  "mannerisms": {
                    "type": "string"
                  },
                  "boundaries": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              },
              "prompts": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "field_sources": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^src_[a-f0-9]{16}$"
                  }
                }
              },
              "canon_notes": {
                "type": "string"
              },
              "review_status": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "kind",
                "text_path",
                "text_sha256",
                "retrieved_at",
                "review_status"
              ]
            }
          },
          "character_context": {
            "type": "object",
            "required": [
              "path",
              "prompt_path",
              "voice_logs_path",
              "completeness"
            ]
          },
          "status": {
            "enum": [
              "ready_for_review",
              "no_clean_references",
              "unassigned"
            ]
          },
          "embeddings": {
            "type": "array"
          },
          "expression": {
            "type": "object"
          },
          "transcription": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "recordings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "sample_rate",
          "channels",
          "duration",
          "original_sha256",
          "speaker_bindings",
          "segments"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}

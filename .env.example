# ============================================================
# ENGRAM / PYRI - local (offline) configuration
#
# Copy this file to ".env" and edit the values below. The local
# setup/start scripts (scripts/local/) copy it for you on first run.
# Lines starting with "#" are comments. Avoid spaces around "=".
# ============================================================

# --- Database (required) ---
# Local PostgreSQL connection string. Create the database first, e.g.:
#   createdb engram
# (or with psql:  CREATE DATABASE engram;)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/engram

# --- Server (required) ---
# Port the unified local server listens on. It serves BOTH the dashboard
# and the /api endpoints, so the whole app runs on this one port.
PORT=5000

# --- Language model (OpenAI-compatible) ---
# Point these at a local runtime to run fully offline. Examples:
#   Ollama:    http://localhost:11434/v1
#   LM Studio: http://localhost:1234/v1
#   llama.cpp / vLLM: their OpenAI-compatible URL
# The default below lets the server boot even if the model isn't running
# yet; chat and autonomous transmissions only work once the model is up.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=local

# --- Optional: multimodal media perception ---
# Vision model for image/video understanding (defaults to LLM_MODEL).
# LLM_VISION_MODEL=llava
# Speech-to-text model for audio/video transcription.
# LLM_TRANSCRIBE_MODEL=whisper

# --- Optional: tuning ---
# LOG_LEVEL=info
# MEDIA_MAX_BYTES=26214400

# --- Release repository (shared by the web build and API) ---
# The Download page's external release-notes link and the API's GitHub fallback
# both use this owner/repo. Set it for a fork or staging release repository
# before building the web app and in the API runtime environment.
VITE_GITHUB_REPO=Tech953/Ch-IO
# Legacy API-only override; prefer VITE_GITHUB_REPO so the web and API agree.
# DOWNLOADS_GITHUB_REPO=Tech953/Ch-IO

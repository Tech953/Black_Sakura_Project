    {
      "id": "FR-A02",
      "status": "Implemented controls; character artwork still limited",
      "change": "Unsupported broad arm influence disabled; exact protected-geometry checks pass; neutral rig has separate shoulder/elbow/wrist joints. Rebecca needs authored parts and corrective poses."
    },
    {
      "id": "FR-A03",
      "status": "Open artwork review",
      "change": "40 current flags retained with unchanged thresholds. Removal of unsafe warping exposes larger authored-pose jumps; no artist rationale or blanket approval has been invented."
    },
    {
      "id": "FR-A04",
      "status": "Implemented; character view coverage pending",
      "change": "Shared six-shot timeline and actual camera orbit; original 720-frame 60 fps neutral-rig movie. Rebecca remains one supplied unmeasured view."
    },
    {
      "id": "FR-A05",
      "status": "Implemented supported subset",
      "change": "glTF/GLB triangle surfaces, depth, base-color textures, skinning and TRS clips; actual OpenGL shader path tested. PBR, compressed extensions and morphs are outside the supported subset."
    },
    {
      "id": "FR-A06",
      "status": "Implemented",
      "change": "Canonical 1.0.0 format, checked imports, stable profile bindings and explicit unsupported mode/view errors."
    },
    {
      "id": "FR-A07",
      "status": "Implemented",
      "change": "Atomic full-history SQLite import, source byte/hash retention, explicit CSV/text mappings, pagination and complete export. Context retrieval does not delete stored history."
    },
    {
      "id": "FR-A08",
      "status": "Implemented local/provider core; host incorporation pending",
      "change": "Actual bundled Qwen/llama.cpp text generation; validated host callback adapter. The ENGRAM repository has not been supplied or edited."
    },
    {
      "id": "FR-A09",
      "status": "Implemented energy-driven performance; acting review pending",
      "change": "Actual F5 speech drives sample-clock mouth motion; new voiced 2D movie. Alignment is energy-only, not phonemes."
    },
    {
      "id": "FR-A10",
      "status": "Implemented shared widget; Windows/device acceptance pending",
      "change": "Same session/identity core in embedded Qt panel and separate native window; Linux offscreen startup exercised."
    },
    {
      "id": "FR-A11",
      "status": "Installer rebuilt; native acceptance pending",
      "change": "One internally complete installer with private runtime and 20 local model assets. Archive/hash validation is distinct from Windows loader/install acceptance."
    },
    {
      "id": "FR-A12",
      "status": "Measurement tools implemented; target-machine gate open",
      "change": "Async workers, cancellation lifetime, 120 Hz presentation target, saved viewport observations and independent completed-frame GPU-path test. No ROG pacing guarantee."
    },
    {
      "id": "FR-A13",
      "status": "Original benchmark implemented; art comparison pending",
      "change": "Actual six-shot geometry benchmark, new 60 fps media and explicit anatomy/cinematography criteria. No Studio Trigger fidelity score."
    },
    {
      "id": "FR-A14",
      "status": "Implemented local review workflow",
      "change": "Transcript-to-issue ledger retained; current evidence and remaining inputs recorded without optional web lookup blocking local work."
    }
  ],

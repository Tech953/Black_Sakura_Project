{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:full-rezz:scene-layout:1.0.0",
  "title": "FULL_REZZ authored scene-layout guide",
  "description": "Runtime also checks camera degeneracy, far > near, unique IDs, contact coverage, contained rectangles and edge references. This format is not a CAD importer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canvas",
    "provenance",
    "camera",
    "anchors",
    "objects",
    "background_regions",
    "thresholds"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "canvas": {
      "const": [
        1280,
        720
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "metric_geometry_verified",
        "notes"
      ],
      "properties": {
        "kind": {
          "const": "authored_guide"
        },
        "metric_geometry_verified": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "camera": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eye",
            "target",
            "up",
            "near",
            "far",
            "projection",
            "vertical_span"
          ],
          "properties": {
            "eye": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000.0,
                "maximum": 1000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "target": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000.0,
                "maximum": 1000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "up": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000.0,
                "maximum": 1000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "near": {
              "type": "number",
              "minimum": 1e-05,
              "maximum": 1000000.0
            },
            "far": {
              "type": "number",
              "minimum": 1e-05,
              "maximum": 1000000.0
            },
            "projection": {
              "const": "orthographic"
            },
            "vertical_span": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 1000000.0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eye",
            "target",
            "up",
            "near",
            "far",
            "projection",
            "vertical_fov_degrees"
          ],
          "properties": {
            "eye": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000.0,
                "maximum": 1000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "target": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000.0,
                "maximum": 1000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "up": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000.0,
                "maximum": 1000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "near": {
              "type": "number",
              "minimum": 1e-05,
              "maximum": 1000000.0
            },
            "far": {
              "type": "number",
              "minimum": 1e-05,
              "maximum": 1000000.0
            },
            "projection": {
              "const": "perspective"
            },
            "vertical_fov_degrees": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 170
            }
          }
        }
      ]
    },
    "anchors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "world",
          "contact_index"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,48}$"
          },
          "world": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -1000000.0,
              "maximum": 1000000.0
            },
            "minItems": 3,
            "maxItems": 3
          },
          "contact_index": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "vertices",
          "edges"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,48}$"
          },
          "vertices": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2048,
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000.0,
                "maximum": 1000000.0
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "edges": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8192,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2047
              }
            }
          }
        }
      }
    },
    "background_regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,48}$"
          },
          "rect": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1280
            }
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_error_design_pixels",
        "background_mean_absolute_error_rgb",
        "minimum_region_samples"
      ],
      "properties": {
        "projection_error_design_pixels": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 2
        },
        "background_mean_absolute_error_rgb": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 12
        },
        "minimum_region_samples": {
          "type": "integer",
          "minimum": 16,
          "maximum": 63
        }
      }
    }
  }
}

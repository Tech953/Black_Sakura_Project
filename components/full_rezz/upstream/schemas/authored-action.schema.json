{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:full-rezz:bridge:authored-action:1.0.0",
  "title": "FULL_REZZ existing authored action descriptor",
  "type": "object",
  "properties": {
    "bridge_schema_version": {
      "const": "1.0.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^voice_[a-f0-9]{16}$"
    },
    "kind": {
      "const": "full_rezz_authored_action"
    },
    "fps": {
      "type": "integer",
      "minimum": 60,
      "maximum": 240
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 864000
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 14400
    },
    "voice_offset_seconds": {
      "type": "number",
      "minimum": 0
    },
    "voice_duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "voice_path": {
      "type": "string"
    },
    "voice_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "media_path": {
      "type": "string"
    },
    "media_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "pose_id": {
            "type": "string",
            "minLength": 1
          },
          "time_seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "frame",
          "pose_id"
        ],
        "additionalProperties": true
      }
    },
    "automatic_reanimation": {
      "const": false
    }
  },
  "required": [
    "bridge_schema_version",
    "kind",
    "profile_id",
    "fps",
    "frame_count",
    "duration_seconds",
    "voice_offset_seconds",
    "voice_duration_seconds",
    "voice_path",
    "voice_sha256",
    "media_path",
    "media_sha256",
    "statement",
    "events",
    "automatic_reanimation"
  ],
  "additionalProperties": true
}

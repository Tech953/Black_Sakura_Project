# This Run command exercises the portable bridge, not the desktop server.
entrypoint = "main.py"
run = ["python3", "main.py"]
language = "python3"
modules = ["python-3.10:v18-20230807-322e88b"]

[nix]
channel = "stable-23_05"

[unitTest]
language = "python3"

[packager]
language = "python3"
ignoredPaths = ["FULL_REZZ", "full_rezz_build", "animation"]

[packager.features]
guessImports = false
packageSearch = false
enabledForHosting = false

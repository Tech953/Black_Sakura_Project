powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; $kind='installer'; $base=(Get-Location).Path; $stage=$null; $logging=$false; try { Start-Transcript -Path (Join-Path $base ('FULL_REZZ_Assembly_'+$kind+'.log')) -Force | Out-Null; $logging=$true; $mp=Join-Path $base 'FULL_REZZ_3.0_Repair_Manifest.json'; if((Get-FileHash -LiteralPath $mp -Algorithm SHA256).Hash -ne '6e569ee27dc91bb8dbe448ccf6b70d148c24a2228bf31ef63fa811fd597c27d5'){throw 'The recovery manifest is missing or changed. Extract the matching Recovery_Tools ZIP again.'}; $m=Get-Content -LiteralPath $mp -Raw | ConvertFrom-Json; $item=$m.outputs.$kind; if(-not $item -or [IO.Path]::GetFileName($item.name) -ne $item.name){throw 'Invalid output filename in manifest.'}; $target=Join-Path $base $item.name; if(Test-Path -LiteralPath $target){ if((Get-Item -LiteralPath $target).Length -ne $item.bytes -or (Get-FileHash -LiteralPath $target -Algorithm SHA256).Hash -ne $item.sha256){throw 'A different output already exists. Move it to another folder before assembling.'}; Write-Host ('Already verified: '+$item.name); Stop-Transcript | Out-Null; exit 0 }; foreach($b in $item.bundles){ if([IO.Path]::GetFileName($b.name) -ne $b.name){throw 'Invalid ZIP filename in manifest.'}; $p=Join-Path $base $b.name; Write-Host ('Checking '+$b.name); if(-not(Test-Path -LiteralPath $p)){throw ('Missing download: '+$b.name)}; if((Get-Item -LiteralPath $p).Length -ne $b.bytes -or (Get-FileHash -LiteralPath $p -Algorithm SHA256).Hash -ne $b.sha256){throw ('Damaged or wrong download: '+$b.name)} }; Add-Type -AssemblyName System.IO.Compression; Add-Type -AssemblyName System.IO.Compression.FileSystem; $drive=New-Object -TypeName System.IO.DriveInfo -ArgumentList ([IO.Path]::GetPathRoot($base)); if($drive.AvailableFreeSpace -lt ($item.bytes+67108864)){throw 'Insufficient free disk space for assembly.'}; $stage=$target+'.assembling.'+[Guid]::NewGuid().ToString('N'); $out=[IO.File]::Create($stage); try { foreach($b in $item.bundles){ Write-Host ('Reading '+$b.name); $z=[IO.Compression.ZipFile]::OpenRead((Join-Path $base $b.name)); try { $e=$z.GetEntry($b.entry); if(-not $e -or $e.Length -ne $b.payload_bytes){throw ('Invalid content in '+$b.name)}; $s=$e.Open(); try { $s.CopyTo($out) } finally { $s.Dispose() } } finally { $z.Dispose() } } } finally { $out.Dispose() }; if((Get-Item -LiteralPath $stage).Length -ne $item.bytes -or (Get-FileHash -LiteralPath $stage -Algorithm SHA256).Hash -ne $item.sha256){throw 'Reconstructed output checksum failed.'}; [IO.File]::Move($stage,$target); $stage=$null; Write-Host ('VERIFIED: '+$item.name); Stop-Transcript | Out-Null; exit 0 } catch { Write-Host ('ASSEMBLY FAILED: '+$_.Exception.Message) -ForegroundColor Red; if($stage -and (Test-Path -LiteralPath $stage)){Remove-Item -LiteralPath $stage -Force}; if($logging){Stop-Transcript | Out-Null}; exit 1 }"
